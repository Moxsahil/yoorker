DATABASE_URL=postgres://yoorker:yoorker@localhost:5432/yoorker
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000

# Browser origins allowed to call the API with cookies (exact, no trailing slash), comma-separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

OTP_HASH_SECRET=dev-only-otp-secret-change-me-0123456789

# Google sign-in (ADR-0007): the OAuth "Web application" client ID. Comma-separate several.
GOOGLE_CLIENT_IDS=
# Phone OTP sign-in. On by default outside production; the log sender only prints codes.
# PHONE_OTP_ENABLED=false


# Sentry error reporting (TURF-106). Leave blank locally; set on Render.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging